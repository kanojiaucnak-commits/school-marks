# Secrets for `supabase functions serve --env-file supabase/.env.local`.
#
# Copy to `.env.local`, fill in, and never commit it. Production secrets are set
# with `supabase secrets set` or via the Supabase dashboard — not from a file.
#
# Everything here is server-side only. None of it may ever appear in a VITE_
# variable, a frontend/.env file, or a migration.

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# In production the platform injects these automatically. `functions serve` does
# not, which is why they are listed here for local use.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses RLS. That is exactly why the Edge Functions
# need it AND why every one of them re-checks permissions by hand — see
# `_shared/auth.ts`.
SUPABASE_URL=https://nhqobdectcswnfmmyqtw.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xwzxIJbYO_nePXZVHOhJ8A_r6CbXERD
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Clerk
# -----------------------------------------------------------------------------

# Your Clerk instance domain. The functions fetch the JWKS from
# `<issuer>/.well-known/jwks.json` and verify every session token against it.
CLERK_ISSUER=https://musical-giraffe-9535.clerk.accounts.dev

# Backend API key. Required ONLY by admin-create-clerk-user, which creates Clerk
# users when an administrator adds a staff member. This is the one place a Clerk
# secret is needed, and it is why that function exists rather than the browser
# calling Clerk directly.
#
#   supabase secrets set CLERK_SECRET_KEY=sk_...
#
CLERK_SECRET_KEY=

# -----------------------------------------------------------------------------
# OCR provider
# -----------------------------------------------------------------------------
# Which provider ocr-process uses: google | azure | textract | manual
#
# `manual` extracts nothing by design. With no working provider configured,
# requiring a human to type the marks is safer than presenting an empty
# extraction that looks like a blank mark sheet.
OCR_PROVIDER=manual

# Google Cloud Vision
GOOGLE_VISION_API_KEY=

# Azure AI Vision
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=

# AWS Textract. Detection only — no word bounding boxes — and images only, not
# PDFs, so a school using it will get worse OCR than with Google or Azure.
AWS_TEXTRECT_ACCESS_KEY_ID=
AWS_TEXTRECT_SECRET_ACCESS_KEY=
AWS_REGION=

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------
# Reported to the Settings page as the runtime environment.
ENVIRONMENT=development