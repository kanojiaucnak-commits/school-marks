# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
dist/
build/
worker/dist/
frontend/dist/

# Cloudflare — the Workers/D1/R2 stack has been retired. The local state dir is
# kept ignored so that stale local databases are never committed if a developer
# still has one lying around.
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example
.mf/
*.wrangler/

# Supabase
# `supabase/.temp/` holds the local project ref and cached credentials.
supabase/.temp/
supabase/.branches/
supabase/.env
# Never commit a dump of a real school database.
supabase/*.sql.gz

# Environment / secrets — NEVER COMMIT
.env
.env.*
!.env.example
*.pem
*.key

# Local database dumps
*.sqlite
*.sqlite3
*.db
dumps/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

# Test / coverage
coverage/
.nyc_output/

# Misc
.cache/
tmp/